# Copy these names into the Vercel project Environment Variables UI.
# Replace every placeholder with a value from the appropriate provider.

# Use a managed PostgreSQL connection string (prefer its pooled URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a stable, high-entropy value (at least 32 random bytes).
SESSION_SECRET=replace-with-a-stable-random-secret

# Required to generate product reviews.
XAI_API_KEY=replace-with-your-xai-api-key
# Optional administrator allowlist (used by the plan activation endpoint).
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Use keys from a Clerk application that you own. Never copy values from the
# Replit-managed tenant; it is not being migrated or made exportable here.
# Use the live keys for Production and suitable test keys for Preview.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace-with-your-own-clerk-publishable-key
CLERK_PUBLISHABLE_KEY=pk_live_replace-with-your-own-clerk-publishable-key
CLERK_SECRET_KEY=sk_live_replace-with-your-own-clerk-secret-key

# Vercel's build command sets VITE_AUTH_PROVIDER=clerk when VERCEL=1.
# Set both provider variables to clerk when enabling external Clerk locally.
VITE_AUTH_PROVIDER=clerk
# Optional outside Vercel; VERCEL=1 enables external Clerk mode automatically.
AUTH_PROVIDER=clerk

# Do not set VITE_CLERK_PROXY_URL on Vercel: external Clerk uses its standard
# endpoints and keys directly, without Replit's Clerk proxy.